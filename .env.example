PORT=5000
MONGO_URI=
JWT_SECRET=
SCRAPINGDOG_API_KEY=
OMKAR_SHEIN_API_KEY=
# Webhook de Make que te avisa a TI (Telegram) de cada cotizacion nueva
MAKE_WEBHOOK_URL=
# Zona horaria para los reportes del dashboard admin (por defecto America/Santo_Domingo)
STATS_TIMEZONE=
# En produccion (Render) poner NODE_ENV=production
NODE_ENV=
# Opcional: clave que se envia en el header x-make-apikey (activa 'API key' en el webhook de Make para exigirla)
MAKE_WEBHOOK_SECRET=
# Tope de llamadas pagadas a Scrapingdog/Omkar por dia, sumando todos los clientes (por defecto 300)
TOPE_LLAMADAS_DIARIAS=
